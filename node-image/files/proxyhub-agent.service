# Proxy-Hub node agent: registers once, then applies the panel's desired state to Telemt and Xray.
[Unit]
Description=Proxy-Hub node agent
After=network-online.target cloud-final.service proxyhub-lockdown.service
Wants=network-online.target
# Written by cloud-init from the panel (panel URL, node id, CA, one-time token).
ConditionPathExists=/etc/proxyhub-agent/agent.json

[Service]
Type=simple
ExecStart=/usr/local/bin/proxyhub-agent -config /etc/proxyhub-agent/agent.json run
Restart=always
RestartSec=5
# Root only to chown the Telemt and Xray configs to their service users and to reload/restart
# telemt.service and xray.service.
User=root
CapabilityBoundingSet=CAP_CHOWN CAP_FOWNER CAP_DAC_OVERRIDE
NoNewPrivileges=true
LimitCORE=0
ProtectSystem=strict
ReadWritePaths=/etc/telemt /etc/xray /etc/proxyhub-agent /var/lib/proxyhub-agent
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
UMask=0077

[Install]
WantedBy=multi-user.target
