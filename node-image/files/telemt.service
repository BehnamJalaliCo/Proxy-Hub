# Telemt MTProto proxy on a Proxy-Hub node. The config is written only by proxyhub-agent.
[Unit]
Description=Telemt MTProto proxy (managed by proxyhub-agent)
After=network-online.target nftables.service
Wants=network-online.target
# Without this file Telemt would write and run a built-in default config (default user with an
# all-zero secret, beobachten on). It must never start before the agent has rendered ours.
ConditionPathExists=/etc/telemt/telemt.toml

[Service]
Type=simple
User=telemt
Group=telemt
WorkingDirectory=/var/lib/telemt
ExecStart=/usr/local/bin/telemt /etc/telemt/telemt.toml
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=2
# Rule 7: no process output is kept anywhere (log_level is "silent" as well).
StandardOutput=null
StandardError=null
UnsetEnvironment=RUST_LOG
LimitNOFILE=1048576
LimitCORE=0
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ReadOnlyPaths=/etc/telemt
ReadWritePaths=/var/lib/telemt
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native
UMask=0077

[Install]
WantedBy=multi-user.target
