{
	admin off
	# UDP 443 is not published/opened, so do not advertise HTTP/3 (alt-svc h3).
	servers {
		protocols h1 h2
	}
}

{$PANEL_DOMAIN} {
	encode zstd gzip

	# Internal endpoints (metrics, health) are never public; the deployer uses 127.0.0.1:8000.
	@internal path /internal/* /healthz /livez
	respond @internal 404

	reverse_proxy api:8000 {
		header_down -Via
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		-Server
	}

	# No access log (CLAUDE.md rule 7 spirit: we keep no visitor IPs anywhere).
	log {
		output discard
	}
}
